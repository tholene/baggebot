# ---------------------------------------------------------------------------
# Cleanup bot credentials
# ---------------------------------------------------------------------------
# From the Discord Developer Portal -> your cleanup application -> "Bot" ->
# "Reset Token". This is a BOT token, not the application public key and not a
# personal user token. Never commit the real value.
DISCORD_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Target (these are the real, non-secret IDs for this one-shot cleanup)
# ---------------------------------------------------------------------------
GUILD_ID=240837008212230144
CHANNEL_ID=1279867299066675321
RAID_HELPER_USER_ID=579155972115660803

# ---------------------------------------------------------------------------
# Safety switches
# ---------------------------------------------------------------------------
# Anything other than the literal string "false" is treated as a dry run.
DRY_RUN=true

# Delete EVERY Raid-Helper message in the channel. Dangerous. Mutually
# exclusive with KEEP_FROM_MESSAGE_ID.
DELETE_ALL_MATCHES=false

# The oldest Raid-Helper message that should be PRESERVED. This message and all
# newer ones are kept; older Raid-Helper messages are deleted.
KEEP_FROM_MESSAGE_ID=

# Must be exactly DELETE_RAID_HELPER_MESSAGES for a real deletion.
CONFIRM_DELETE=

# Optional guard: refuse to delete more than this many messages in one run.
# Empty means "use the built-in default cap" (see README).
MAX_DELETE=

# ===========================================================================
# BaggeBot (/bonk) — the persistent gateway bot
# ===========================================================================
# These are only needed by bot.mjs / register-commands.mjs. The one-shot
# cleanup scripts ignore them.
#
# To copy a role ID: Discord → Settings → Advanced → Developer Mode on, then
# Server Settings → Roles → right-click the role → Copy Role ID.

# The roster. Everyone with this role is expected to sign up for raids.
RAIDER_ROLE_ID=

# Who is allowed to run /bonk. Checked server-side on every invocation.
OFFICER_ROLE_ID=

# Comma-separated channels that raids are posted in. Raid-Helper events in any
# other channel (roster sign-ups, alt lists, other teams) are ignored, so /bonk
# can never pick one and DM the wrong people. Leave empty to consider every
# channel, which is rarely what you want.
RAID_CHANNEL_IDS=

# Optional. Comma-separated roles that are exempt from bonking even if they
# also hold RAIDER_ROLE_ID — trials, socials, alt-only members.
EXCLUDE_ROLE_IDS=

# From Raid-Helper: a server admin runs /apikey in Discord and Raid-Helper
# DMs the key back. Without it /bonk cannot auto-pick the next raid, and
# officers must pass the `event:` option explicitly.
# (RAID_HELPER_API_KEY is also accepted, for older .env files.)
RAID_HELPER_TOKEN=

# Milliseconds between DMs. Bulk-opening DM channels quickly is what gets bots
# flagged for spam; the bot refuses to start below 1000.
DM_DELAY_MS=2500
