# Secrets — never commit
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Logs / OS noise
*.log
npm-debug.log*
.DS_Store

# Record of DMs actually sent. Local runtime output, not configuration, and it
# contains member names and message bodies. The directory itself is tracked:
# Docker auto-creates a missing bind-mount target as root, which the container
# then cannot write to.
logs/*
!logs/.gitkeep

# IDE
.idea/
